# Single source of truth for secrets: read by docker-compose.yml (variable
# substitution) and by backend/main.py directly (python-dotenv walks up to find
# this file when there's no backend/.env). Never commit the real .env.

# CORS origin the frontend is served from
FRONTEND_ORIGIN=http://localhost:5173

# Postgres — used both to configure the `db` container and to build DATABASE_URL below.
# docker-compose's .env has no variable interpolation of its own, so if you change
# these, update DATABASE_URL to match.
POSTGRES_USER=rhymathic
POSTGRES_PASSWORD=change_me_to_a_random_secret
POSTGRES_DB=rhymathic

# Full connection string the backend actually uses. Host is "db" (the compose
# service name) when running via Docker, or "localhost" when running the
# backend directly against a locally exposed Postgres.
DATABASE_URL=postgresql://rhymathic:change_me_to_a_random_secret@db:5432/rhymathic

# Secret used to sign auth JWTs — use a long random value, never reuse across environments
JWT_SECRET=change_me_to_a_random_secret

# Seeded admin account — created/re-synced on every backend startup so you can
# always recover access by editing these and restarting, even if the password
# in the DB is forgotten.
ADMIN_EMAIL=admin@rhymathic.local
ADMIN_PASSWORD=change_me

# Optional, used by the planned LLM chat feature
MISTRAL_API_KEY=your_api_key_here

# Passed through to the frontend container (VITE_API_URL there is Vite-specific
# and read from frontend/.env when running the frontend outside Docker)
VITE_API_URL=http://localhost:8000
